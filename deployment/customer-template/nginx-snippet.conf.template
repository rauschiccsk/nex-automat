# nginx server block for customer "${SLUG}"
# Routes <slug>.isnex.eu (HTTPS) → frontend container on internal Docker network
# nex-proxy-net. Per-customer LE cert at /etc/letsencrypt/live/<slug>.isnex.eu/.
# This snippet drops into /etc/nginx/conf.d/<slug>.conf

server {
    listen 80;
    server_name ${SLUG}.isnex.eu;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ${SLUG}.isnex.eu;

    ssl_certificate /etc/letsencrypt/live/${SLUG}.isnex.eu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SLUG}.isnex.eu/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Proxy to per-customer frontend container (internal Docker network).
    location / {
        proxy_pass http://${SLUG}-frontend:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
    }

    access_log /var/log/nginx/${SLUG}-access.log;
    error_log /var/log/nginx/${SLUG}-error.log;
}
