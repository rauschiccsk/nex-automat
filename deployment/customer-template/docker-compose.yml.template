# NEX Manager — Per-customer compose stack
# Generated from this template by scripts/onboard-customer.sh
# Each customer gets their own copy in /opt/customers/<slug>/docker-compose.yml
#
# Required environment variables (from .env in same directory):
#   SLUG                — customer short identifier (lowercase, used in container names)
#   POSTGRES_PASSWORD   — unique random password
#   JWT_SECRET_KEY      — unique random secret (64+ bytes recommended)
#   IMAGE_TAG           — backend/frontend image tag (default 'latest', pin to git SHA for stable deploys)
#   FRONTEND_PORT       — host port (127.0.0.1-only) used by host nginx to reach frontend container
#                         allocated by onboard-customer.sh from range 19000-19499
#
# Routing path: browser → CF → ANDROS:443 → host nginx (cert termination)
#                → 127.0.0.1:${FRONTEND_PORT} → frontend container :80
#                → /api proxy → backend container :9110 (Docker DNS via ${SLUG}-net)

services:
  postgres:
    image: postgres:16-alpine
    container_name: ${SLUG}-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: nex_automat
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - app-net
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5

  backend:
    image: nex-manager-api:${IMAGE_TAG:-latest}
    container_name: ${SLUG}-backend
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      POSTGRES_HOST: postgres
      POSTGRES_PORT: 5432
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: nex_automat
      JWT_SECRET_KEY: ${JWT_SECRET_KEY}
      LOG_LEVEL: INFO
    networks:
      - app-net
    healthcheck:
      # Backend image is Python-based and does not ship wget/curl — use python
      # urllib (always present) to hit the FastAPI /health endpoint.
      test: ["CMD", "python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:9110/health',timeout=3).status==200 else 1)"]
      interval: 30s
      timeout: 5s
      retries: 3

  frontend:
    image: nex-manager-frontend:${IMAGE_TAG:-latest}
    container_name: ${SLUG}-frontend
    restart: unless-stopped
    depends_on:
      - backend
    # Bind to 127.0.0.1 only — host nginx is the only consumer; no external exposure
    ports:
      - "127.0.0.1:${FRONTEND_PORT}:80"
    networks:
      - app-net
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "-", "http://127.0.0.1/"]
      interval: 30s
      timeout: 5s
      retries: 3

networks:
  app-net:
    name: ${SLUG}-net
    driver: bridge

volumes:
  postgres_data:
    name: ${SLUG}_postgres_data
