# NEX Manager — Per-customer compose stack
# Generated from this template by scripts/onboard-customer.sh
# Each customer gets their own copy in /opt/customers/<slug>/docker-compose.yml
#
# Required environment variables (from .env in same directory):
#   SLUG                — customer short identifier (lowercase, used in container names)
#   POSTGRES_PASSWORD   — unique random password
#   JWT_SECRET_KEY      — unique random secret (64+ bytes recommended)
#   IMAGE_TAG           — backend/frontend image tag (default 'latest', can pin to git SHA)
#
# Containers expose NO host ports — all traffic via host nginx reverse proxy
# routing <slug>.nex-automat.isnex.eu → frontend container (port 80) on internal network.

services:
  postgres:
    image: postgres:16-alpine
    container_name: ${SLUG}-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: nex_automat
    volumes:
      - ${SLUG}_postgres_data:/var/lib/postgresql/data
    networks:
      - ${SLUG}-net
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5

  backend:
    image: nex-manager-backend:${IMAGE_TAG:-latest}
    container_name: ${SLUG}-backend
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      POSTGRES_HOST: postgres
      POSTGRES_PORT: 5432
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: nex_automat
      JWT_SECRET_KEY: ${JWT_SECRET_KEY}
      LOG_LEVEL: INFO
    networks:
      - ${SLUG}-net
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "-", "http://127.0.0.1:9110/health"]
      interval: 30s
      timeout: 5s
      retries: 3

  frontend:
    image: nex-manager-frontend:${IMAGE_TAG:-latest}
    container_name: ${SLUG}-frontend
    restart: unless-stopped
    depends_on:
      - backend
    networks:
      - ${SLUG}-net
      - nex-proxy-net  # shared network with host nginx for routing
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "-", "http://127.0.0.1/"]
      interval: 30s
      timeout: 5s
      retries: 3

networks:
  ${SLUG}-net:
    name: ${SLUG}-net
    driver: bridge
  nex-proxy-net:
    external: true  # created once at ANDROS setup; all customer frontends join

volumes:
  ${SLUG}_postgres_data:
    name: ${SLUG}_postgres_data
