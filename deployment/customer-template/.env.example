# NEX Manager — per-customer environment file
# This file is generated by scripts/onboard-customer.sh with random secrets.
# DO NOT commit to git — gitignored at /opt/customers/<slug>/.env

# Customer slug (lowercase, 3-15 chars, alphanumeric + '-')
SLUG=icc

# Image tag (default 'latest', pin to git SHA for stable deploys)
IMAGE_TAG=latest

# PostgreSQL — generated random by onboard script
POSTGRES_PASSWORD=CHANGE_ME

# JWT — generated random by onboard script (64 bytes base64)
JWT_SECRET_KEY=CHANGE_ME
